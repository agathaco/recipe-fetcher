# Copy to .env.local and fill in.

# Neon Postgres connection string — Neon dashboard > Connection Details > "Pooled connection".
# Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# No shared APP_PASSWORD anymore: the app has real per-account sign-up/login
# now (see the `user` table), nothing to configure here for auth.

# Vercel Blob store token, for recipe photo uploads. Vercel dashboard > your
# project > Storage > Create Database > Blob, then copy the token it gives you
# (it also gets added to your Vercel env vars automatically for the deployed
# app; this is only needed here for local dev, in .env.local).
BLOB_READ_WRITE_TOKEN=""
